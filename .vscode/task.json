{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run server",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-pthread",
                "-o",
                "${workspaceFolder}/myhttpserver",
                "${workspaceFolder}/*.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "detail": "编译所有 .cpp 并生成可执行文件"
        },
        {
            "label": "run server",
            "type": "shell",
            "command": "${workspaceFolder}/myhttpserver",
            "dependsOn": ["build and run server"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "先编译，再运行服务器"
        }
    ]
}